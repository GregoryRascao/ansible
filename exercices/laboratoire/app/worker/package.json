    "rxjs": "^7.8.1",
    "ssh2-sftp-client": "^11.0.0",
    "supertest": "^7.0.0",
    "ts-array-extensions": "^3.0.0",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0",
    "webpack": "^5.102.1",
    "winston": "^3.17.0",
    "ws": "^8.18.1",
    "zod": "^4.1.11"
