{
  "name": "3053-waves-backend",
  "packageManager": "yarn@4.9.2",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "jwt:secret": "node -e \"console.log(require('crypto').randomBytes(256).toString('base64'));\"",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:development": "SET NODE_ENV=development& nest start --watch --env-file env/.env.development",
    "start:acceptance": "SET NODE_ENV=acceptance& node dist/main",
    "start:debug": "nest start --debug --watch",
    "start:prod": "SET NODE_ENV=production& node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@logtail/node": "^0.5.5",
    "@logtail/winston": "^0.5.5",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.12",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/sequelize": "^11.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/websockets": "^11.1.12",
    "amqplib": "^0.10.8",
    "axios": "^1.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cron": "4.3.5",
    "date-fns": "^4.1.0",
    "duration-fns": "^3.0.2",
    "keycloak-connect": "^26.1.1",
    "mongoose": "^8.15.0",
    "nest-keycloak-connect": "^1.10.1",
    "nest-winston": "^1.10.2",
    "nestjs-zod": "^5.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "ts-array-extensions": "^3.0.0",
    "winston": "^3.17.0",
    "zod": "4.1.11"
