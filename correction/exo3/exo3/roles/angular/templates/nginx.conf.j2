server {
    listen 80 default_server;
    listen [::]:80 default_server;

    # Using _ as a wildcard for any IP/Domain hitting this server
    server_name _;

    # FRONTEND - Angular static files
    # IMPORTANT: Ensure this path leads to the folder containing index.html
    root /var/www/frontend/dist/browser;
    index index.html;

    # Handle Angular Routing
    location / {
        # The =404 at the end breaks the redirect loop if index.html is missing
        try_files $uri $uri/ /index.html =404;
    }

    # BACKEND PROXY - NestJS
    location /api/ {
        # Pass requests to NestJS running on port 3000
        # No trailing slash on the URL preserves the /api/ prefix
        proxy_pass http://localhost:3000;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Security headers
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-XSS-Protection "1; mode=block";

    # Gzip compression for faster loading
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_min_length 1000;

    # Logging - Helpful for debugging
    access_log /var/log/nginx/frontend-access.log;
    error_log /var/log/nginx/frontend-error.log;

    # Custom Error Page to prevent loops
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}